APP_NAME="Carewell PunchOut"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The storefront runs cross-site inside Coupa's iframe, so Laravel's own
# session cookie (which carries the CSRF token) needs the same posture as
# the punchout session cookie StartController sets by hand: SameSite=None
# requires Secure, which requires the app actually being served over
# HTTPS. Leave these as the framework defaults (lax, unset) for local dev
# over plain HTTP; set them exactly as below on every real deployment.
SESSION_SAME_SITE=none
SESSION_SECURE_COOKIE=true
SESSION_PARTITIONED_COOKIE=true

# How long a PunchoutSession stays active after PunchOutSetupRequest is
# accepted, and how long it stays resolvable in the Transferring grace
# window after the buyer clicks "Transfer cart to Coupa". See
# config/punchout.php.
PUNCHOUT_SESSION_TTL_MINUTES=60
PUNCHOUT_TRANSFER_GRACE_MINUTES=10

# Space-separated list of the domain(s) the storefront may be embedded in
# via iframe, e.g. "https://carewell.coupahost.com". Left empty, the CSP
# frame-ancestors directive defaults to denying all framing, run `php
# artisan punchout:doctor` before any non-local deploy to catch this being
# unset. See Punchout\Http\Middleware\FrameAncestors.
PUNCHOUT_COUPA_FRAME_ANCESTORS=

# How many days of punchout_logs rows to keep. See config/punchout.php and
# the scheduled model:prune in routes/console.php.
PUNCHOUT_LOG_RETENTION_DAYS=90

# Where the "a PO was received" notification email goes. See config/orders.php.
ORDERS_NOTIFICATION_EMAIL=operations@carewellgroup.com.au

# The currency every Cart price lookup requests from Catalog. Must match
# the currency Carewell's contract prices are actually stored in, see
# config/cart.php.
CART_DEFAULT_CURRENCY=AUD

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
